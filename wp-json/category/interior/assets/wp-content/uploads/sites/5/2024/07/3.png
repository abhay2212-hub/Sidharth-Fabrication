 23 22" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M1.5 11L21.5 11" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> <path d="M11.5 1L11.5 21" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> </svg> </button> </h2> <div id="listingFaqAnswer-66d9a450c3635" class="accordion-collapse collapse show" data-bs-parent="#accordionFAQ-66d9a450c362d"> <div class="accordion-body mb-0"> <p>Yes, we provide complete architectural and interior design services from initial planning and layouts to detailed interiors and execution support.</p> </div> </div> </div> <div class="accordion-item"> <h2 class="accordion-header" id="accordionListingFaq-66d9a450c945616"> <button class="accordion-button d-flex justify-content-between align-items-center collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#listingFaqAnswer-66d9a450c945916" aria-expanded="false" aria-controls="2"> <span class="accordion-title fw-semibold">Can you design hospitality spaces within a fixed budget?</span> <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M1.5 11L21.5 11" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> <path d="M11.5 1L11.5 21" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> </svg> </button> </h2> <div id="listingFaqAnswer-66d9a450c945916" class="accordion-collapse collapse " data-bs-parent="#accordionFAQ-66d9a450c362d"> <div class="accordion-body mb-0"> <p>Absolutely. We plan layouts, materials, and design strategies that balance aesthetics, functionality, and cost efficiency.</p> </div> </div> </div> <div class="accordion-item"> <h2 class="accordion-header" id="accordionListingFaq-66d9a450c945617"> <button class="accordion-button d-flex justify-content-between align-items-center collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#listingFaqAnswer-66d9a450c945917" aria-expanded="false" aria-controls="2"> <span class="accordion-title fw-semibold">Can you renovate or redesign existing hotels or restaurants in Bhopal and Indore?</span> <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M1.5 11L21.5 11" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> <path d="M11.5 1L11.5 21" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> </svg> </button> </h2> <div id="listingFaqAnswer-66d9a450c945917" class="accordion-collapse collapse " data-bs-parent="#accordionFAQ-66d9a450c362d"> <div class="accordion-body mb-0"> <p>Yes, we handle renovation, remodeling, and interior upgrades, ensuring minimal disruption to ongoing business operations.</p> </div> </div> </div> <div class="accordion-item"> <h2 class="accordion-header" id="accordionListingFaq-66d9a450c945618"> <button class="accordion-button d-flex justify-content-between align-items-center collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#listingFaqAnswer-66d9a450c945918" aria-expanded="false" aria-controls="2"> <span class="accordion-title fw-semibold">Do you assist during construction and interior execution in Indore?</span> <svg width="23" height="22" viewBox="0 0 23 22" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M1.5 11L21.5 11" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> <path d="M11.5 1L11.5 21" stroke="#253B2F" stroke-width="2" stroke-linecap="square" stroke-linejoin="round" /> </svg> </button> </h2> <div id="listingFaqAnswer-66d9a450c945918" class="accordion-collapse collapse " data-bs-parent="#accordionFAQ-66d9a450c362d"> <div class="accordion-body mb-0"> <p>Yes, we provide site coordination, design supervision, and execution guidance to ensure accurate implementation of approved designs. We provide regular Supervision in Bhopal, Indore, and Ujjain. </p> </div> </div> </div> </div